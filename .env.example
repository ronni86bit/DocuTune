# DocuTune environment configuration (copy to .env and adjust).
# Never commit the real .env file.

# --- Model ---
# Active base model. This value is surfaced in logs, API metadata,
# benchmark manifests and the README. It is NEVER switched silently.
BASE_MODEL=microsoft/Phi-3-mini-4k-instruct
# Optional exact HF revision (branch/tag/commit). Empty = latest default revision.
MODEL_REVISION=
# Which model the API serves by default for /api/extract: base | finetuned
MODEL_MODE=finetuned
# Path to the trained LoRA adapter directory (base model + adapter = fine-tuned model)
ADAPTER_PATH=artifacts/adapters/final
# auto | cpu | cuda
DEVICE=auto
# Load the base model in 4-bit (requires CUDA + bitsandbytes). Leave false for CPU serving.
QUANTIZED=false

# --- Generation ---
MAX_NEW_TOKENS=700

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Maximum accepted resume text length, in characters
MAX_INPUT_CHARS=20000

# --- Paths (defaults are resolved relative to the repository root) ---
RESULTS_DIR=results
ARTIFACTS_DIR=artifacts

# --- Hugging Face ---
# Only needed for gated models (e.g. Llama). Phi-3 and Qwen are open.
HF_TOKEN=
